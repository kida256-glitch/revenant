# No secrets are required. Optional:
# Contact URL or email included in the Wikimedia User-Agent.
REVENANT_CONTACT=https://github.com/kida256-glitch/revenant

# AI gateway: mock (default, offline, no key) or gemini.
AI_PROVIDER=mock
# Server-only. Never commit a real key; set it in Vercel or in your shell.
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite

# Server-only Ed25519 signing key (npm run keys:generate). Empty = decks served unsigned.
REVENANT_SIGNING_KEY=
